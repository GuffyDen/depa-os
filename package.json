{
  "name": "depa-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "db:migrate:local": "node --env-file=.env.local scripts/migrate-postgres.mjs",
    "test:db:up": "NODE_ENV=test node --env-file=.env.test scripts/test-db.mjs up",
    "test:db:migrate": "NODE_ENV=test node --env-file=.env.test scripts/migrate-postgres.mjs",
    "test:db:reset": "NODE_ENV=test node --env-file=.env.test scripts/test-db.mjs reset",
    "test:db:down": "NODE_ENV=test node --env-file=.env.test scripts/test-db.mjs down",
    "test:integration": "NODE_ENV=test node --env-file=.env.test --experimental-strip-types --test tests/postgres/*.test.mjs",
    "test:e2e": "NODE_ENV=test node --env-file=.env.test scripts/run-e2e.mjs",
    "build:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "browser-image-compression": "^2.0.2",
    "drizzle-orm": "0.45.2",
    "heic-to": "^1.5.2",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
